        "# Day 20: Array Stacking, Splitting, and Transposition"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import numpy as np\n\n",
        "x = np.array([[1, 2], [3, 4]])\n",
        "y = np.array([[5, 6], [7, 8]])\n\n",
        "print('Vertical stack (vstack):\\n', np.vstack((x, y)))\n",
        "print('Horizontal stack (hstack):\\n', np.hstack((x, y)))\n",
        "print('Transpose of x:\\n', x.T)"
      ]
    }
  ],
